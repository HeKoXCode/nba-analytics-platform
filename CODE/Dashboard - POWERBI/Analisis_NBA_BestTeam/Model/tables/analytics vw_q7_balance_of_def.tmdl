table 'analytics vw_q7_balance_of_def'

	column team_name
		dataType: string
		sourceProviderType: nvarchar(255)
		summarizeBy: none
		sourceColumn: team_name

		annotation SummarizationSetBy = Automatic

	column season_id
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: season_id

		annotation SummarizationSetBy = Automatic

	column 'Field-goal percentage (FG%)'
		dataType: double
		formatString: 0.0%
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: Eficiencia de tiro

		annotation SummarizationSetBy = Automatic

	column 'Turnovers per game'
		dataType: double
		formatString: 0.0
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: Balones perdidos

		annotation SummarizationSetBy = Automatic

	column balance_score
		dataType: double
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: balance_score

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'analytics vw_q7_balance_of_def' = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(".\SQLEXPRESS", "NBA_Project"),
				    analytics_vw_q7_balance_of_def = Origen{[Schema="analytics",Item="vw_q7_balance_of_def"]}[Data]
				in
				    analytics_vw_q7_balance_of_def

