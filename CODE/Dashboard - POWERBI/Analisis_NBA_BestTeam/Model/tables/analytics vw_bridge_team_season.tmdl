table 'analytics vw_bridge_team_season'

	column team_id
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: team_id

		annotation SummarizationSetBy = Automatic

	column decade
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: decade

		annotation SummarizationSetBy = Automatic

	partition 'analytics vw_bridge_team_season' = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(".\SQLEXPRESS", "NBA_Project"),
				    analytics_vw_bridge_team_season = Origen{[Schema="analytics",Item="vw_bridge_team_season"]}[Data]
				in
				    analytics_vw_bridge_team_season

