table 'analytics vw_q10_recent_top'

	column team_name
		dataType: string
		sourceProviderType: nvarchar(255)
		summarizeBy: none
		sourceColumn: team_name

		annotation SummarizationSetBy = Automatic

	column team_id
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: team_id

		annotation SummarizationSetBy = Automatic

	column 'Win rate (last 10 seasons)'
		dataType: double
		formatString: 0.00%
		sourceProviderType: decimal(24, 12)
		summarizeBy: sum
		sourceColumn: win_rate_10y

		annotation SummarizationSetBy = Automatic

	column 'Points per game (last 10 seasons)'
		dataType: double
		formatString: 0.0
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: ppg_10y

		annotation SummarizationSetBy = Automatic

	column rk_recent
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		summarizeBy: sum
		sourceColumn: rk_recent

		annotation SummarizationSetBy = Automatic

	partition 'analytics vw_q10_recent_top' = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(".\SQLEXPRESS", "NBA_Project"),
				    analytics_vw_q10_recent_top = Origen{[Schema="analytics",Item="vw_q10_recent_top"]}[Data]
				in
				    analytics_vw_q10_recent_top

