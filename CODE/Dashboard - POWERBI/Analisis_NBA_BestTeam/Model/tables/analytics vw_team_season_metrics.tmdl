table 'analytics vw_team_season_metrics'

	column team_id
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: team_id

		annotation SummarizationSetBy = Automatic

	column season_id
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: season_id

		annotation SummarizationSetBy = Automatic

	column games_played
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: games_played

		annotation SummarizationSetBy = Automatic

	column wins
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: wins

		annotation SummarizationSetBy = Automatic

	column losses
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: losses

		annotation SummarizationSetBy = Automatic

	column winrate
		dataType: double
		sourceProviderType: decimal(24, 12)
		summarizeBy: sum
		sourceColumn: winrate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column avg_ppg
		dataType: double
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: avg_ppg

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column avg_fg_pct
		dataType: double
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: avg_fg_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'analytics vw_team_season_metrics' = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Databases("localhost,1433"),
				    NBA_Project = Origen{[Name="NBA_Project"]}[Data],
				    analytics_vw_team_season_metrics = NBA_Project{[Schema="analytics",Item="vw_team_season_metrics"]}[Data]
				in
				    analytics_vw_team_season_metrics

