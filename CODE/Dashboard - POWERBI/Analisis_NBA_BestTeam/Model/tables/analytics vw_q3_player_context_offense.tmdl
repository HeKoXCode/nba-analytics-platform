table 'analytics vw_q3_player_context_offense'

	column player_id
		dataType: int64
		isNullable: false
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: player_id

		annotation SummarizationSetBy = Automatic

	column player_name
		dataType: string
		sourceProviderType: nvarchar(255)
		summarizeBy: none
		sourceColumn: player_name

		annotation SummarizationSetBy = Automatic

	column team_name
		dataType: string
		sourceProviderType: nvarchar(255)
		summarizeBy: none
		sourceColumn: team_name

		annotation SummarizationSetBy = Automatic

	column 'Puntos por partido'
		dataType: double
		formatString: 0.0
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: Puntos por partido

		annotation SummarizationSetBy = Automatic

	column 'Porcentaje de acierto'
		dataType: double
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		sourceProviderType: float
		summarizeBy: sum
		sourceColumn: Porcentaje de acierto

		annotation SummarizationSetBy = Automatic

	partition 'analytics vw_q3_player_context_offense' = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(".\SQLEXPRESS", "NBA_Project"),
				    analytics_vw_q3_player_context_offense = Origen{[Schema="analytics",Item="vw_q3_player_context_offense"]}[Data]
				in
				    analytics_vw_q3_player_context_offense

