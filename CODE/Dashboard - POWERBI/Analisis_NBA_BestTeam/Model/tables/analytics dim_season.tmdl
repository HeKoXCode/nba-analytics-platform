table 'analytics dim_season'

	column season_id
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: season_id

		annotation SummarizationSetBy = Automatic

	column season_year
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: sum
		sourceColumn: season_year

		annotation SummarizationSetBy = Automatic

	column decade
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: decade

		annotation SummarizationSetBy = Automatic

	column era
		dataType: string
		isNullable: false
		sourceProviderType: varchar(9)
		summarizeBy: none
		sourceColumn: era

		annotation SummarizationSetBy = Automatic

	partition 'analytics dim_season' = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Databases("localhost,1433"),
				    NBA_Project = Origen{[Name="NBA_Project"]}[Data],
				    analytics_dim_season = NBA_Project{[Schema="analytics",Item="dim_season"]}[Data]
				in
				    analytics_dim_season

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

