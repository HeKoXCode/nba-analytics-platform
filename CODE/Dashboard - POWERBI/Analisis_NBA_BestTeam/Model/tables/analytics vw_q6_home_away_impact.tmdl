table 'analytics vw_q6_home_away_impact'

	measure PPG_Diferencia_Home_Away = ```
			
			AVERAGE('analytics vw_q6_home_away_impact'[Home points per game]) 
			    - AVERAGE('analytics vw_q6_home_away_impact'[Away points per game])
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PPG_NEG_Diferencia_Home_Away = ```
			
			AVERAGE('analytics vw_q6_home_away_impact'[Away points per game])
			    - AVERAGE('analytics vw_q6_home_away_impact'[Home points per game]) 
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

