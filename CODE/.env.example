# Copy these names into your environment. Do not commit real values.
NBA_SQL_DRIVER=ODBC Driver 17 for SQL Server
NBA_SQL_SERVER=.\SQLEXPRESS
NBA_SQL_DATABASE=NBA_Project

# Local SQL Server Express / Windows authentication (matches the PBIT source).
NBA_SQL_TRUSTED_CONNECTION=yes
NBA_SQL_ENCRYPT=no
NBA_SQL_TRUST_SERVER_CERTIFICATE=yes

# Docker/CI alternative: use localhost,1433, ODBC Driver 18, trusted_connection=no,
# and provide NBA_SQL_USER/NBA_SQL_PASSWORD through the shell or secret manager.
