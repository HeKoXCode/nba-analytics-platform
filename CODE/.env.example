# Copy these names into your environment. Do not commit real values.
NBA_SQL_DRIVER=ODBC Driver 18 for SQL Server
NBA_SQL_SERVER=localhost,1433
NBA_SQL_DATABASE=NBA_Project

# Docker / SQL authentication (recommended for the reproducible local demo).
NBA_SQL_TRUSTED_CONNECTION=no
NBA_SQL_USER=sa
NBA_SQL_PASSWORD=replace_with_a_local_secret
NBA_SQL_ENCRYPT=no
NBA_SQL_TRUST_SERVER_CERTIFICATE=yes

# Alternative: set NBA_SQL_TRUSTED_CONNECTION=yes and leave user/password unset
# when using a local SQL Server instance with Windows authentication.
