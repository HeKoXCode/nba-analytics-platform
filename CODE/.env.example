# Copy these names into your environment. Do not commit real values.
NBA_SQL_DRIVER=ODBC Driver 17 for SQL Server
NBA_SQL_SERVER=localhost\\SQLEXPRESS
NBA_SQL_DATABASE=NBA_Project

# Recommended for a local Windows SQL Server connection.
NBA_SQL_TRUSTED_CONNECTION=yes

# Leave these unset when trusted authentication is enabled.
NBA_SQL_USER=
NBA_SQL_PASSWORD=
